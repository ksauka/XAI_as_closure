# Both Study 1 and Study 2 read the same GITHUB_* pair for the private
# GitHub backup. Required on Streamlit Community Cloud: its filesystem is
# ephemeral, so without these, completed sessions are lost on redeploy/restart.
# Production launches verify access to this repository before the task begins.
GITHUB_REPO = "owner/private-study-data"
GITHUB_TOKEN = "set-in-deployment-secret-store"

# Legacy alternate names, checked as a fallback if the above are unset.
# GITHUB_DATA_REPO = "owner/private-study-data"
# GITHUB_DATA_TOKEN = "set-in-deployment-secret-store"

# Optional: override where local JSONL session/event logs are written.
# Not needed on Streamlit Cloud (its filesystem doesn't persist anyway;
# GITHUB_REPO/GITHUB_TOKEN above are what actually persists the data).
# STUDY1_DATA_ROOT = "/protected/path/study1"
# STUDY2_DATA_ROOT = "/protected/path/study2/interaction_logs"

# Copy to .streamlit/secrets.toml for local Streamlit runs,
# or paste into Streamlit Cloud -> App -> Settings -> Secrets,
# separately for EACH of the nine deployed apps (Study 1 + eight
# condition-locked Study 2 apps) -- secrets are not shared between them.
