# Both studies use the HAI PROLIFIC_PID/pid and return query parameters.
# Study 2 additionally receives its condition in the cond parameter.

# Optional local/self-hosted data directories.
# STUDY1_DATA_ROOT=/protected/path/study1
# STUDY2_DATA_ROOT=/protected/path/study2/interaction_logs

# Required on Streamlit Community Cloud. Add these separately to every app.
# GITHUB_REPO=owner/private-study-data
# GITHUB_TOKEN=set-in-deployment-secret-store
