# CHI Study 1 and Study 2 Qualtrics linkage
# Use a long random secret in deployment. Qualtrics and the app must share it.
STUDY_LINK_SECRET=replace-with-a-long-random-secret

# Study 1 pilot mode permits launch without its signed Qualtrics token.
STUDY1_ALLOW_PILOT=false
# STUDY1_DATA_ROOT=/protected/path/study1

# Study 2 retains the HAI PROLIFIC_PID/cond/return query-parameter flow.
# This optional path is the directory containing per-session JSONL logs.
# STUDY2_DATA_ROOT=/protected/path/study2/interaction_logs
# GITHUB_REPO=owner/private-study-data
# GITHUB_TOKEN=set-in-deployment-secret-store

# Qualtrics injects Study 1's token and Study 2's established query parameters.
