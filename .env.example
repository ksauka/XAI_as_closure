# CHI Study 1 Qualtrics linkage
# Use a long random secret in deployment. Qualtrics and the app must share it.
STUDY_LINK_SECRET=replace-with-a-long-random-secret

# Local pilot mode permits launch without a signed Qualtrics token.
# Set false in production.
STUDY1_ALLOW_PILOT=true
# STUDY1_DATA_ROOT=/protected/path/study1

# Copied HAI snapshot settings below are not used by the CHI Study 1 app.
# Keep them only when running archived HAI code; never commit a real key.
OPENAI_API_KEY=

# Require live OpenAI/Chroma retrieval for study deployment; no offline fallback.
AGENTIC_REQUIRE_LIVE_RAG=true

# GitHub private data repository (session logs)
# Generate a Personal Access Token with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=replace-with-private-data-token
GITHUB_REPO=owner/hiring-study-data-private

# Qualtrics / Prolific return URL (injected by Qualtrics as a URL parameter)
# The app reads ?return=<URL>&pid=<PID>&PROLIFIC_PID=<PID> automatically from the query string.
# No env var needed — set the return URL in your Qualtrics survey flow.
